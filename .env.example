# Telegram bot credentials (replace the placeholders with your real values)
# Create the bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=000000000:REPLACE_WITH_YOUR_BOT_TOKEN

# Your numeric Telegram user ID (get it from @userinfobot). Only this user can use the bot.
TELEGRAM_ALLOWED_USER_ID=000000000

# --- Vercel / webhook settings (optional for local long polling) ---------------
# On Vercel you may provide the token as BOT_TOKEN instead of TELEGRAM_BOT_TOKEN.
# BOT_TOKEN=000000000:REPLACE_WITH_YOUR_BOT_TOKEN

# A random secret (1-256 chars of A-Z a-z 0-9 _ -) that Telegram echoes back in
# the X-Telegram-Bot-Api-Secret-Token header. Required for webhook mode.
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret

# Public base URL of the deployment, used by `npm run set-webhook`.
# On Vercel you can omit this: VERCEL_URL is provided automatically.
# TELEGRAM_WEBHOOK_URL=https://your-project.vercel.app

# --- Optional job-source coverage --------------------------------------------
# Adzuna UK (free tier, https://developer.adzuna.com/). Both ID and KEY are
# required to activate the source; if either is missing the source is skipped
# (a warning is logged when only one is set) and Remotive keeps working.
# The free tier is rate-limited (25 hits/minute, 250 hits/day) and each /search
# uses ADZUNA_MAX_PAGES requests, so keep the page count low.
# ADZUNA_APP_ID=your-app-id
# ADZUNA_APP_KEY=your-app-key
# ADZUNA_COUNTRY=gb
# ADZUNA_MAX_PAGES=2

# --- Optional authoritative sponsorship verification -------------------------
# Verifies EMPLOYER capability against the UK government's official
# "Register of licensed sponsors: workers". Membership only ever proves the
# EMPLOYER is licensed to sponsor; it never confirms that a specific vacancy
# offers sponsorship.
#
# Set this to EITHER of the following (the register is cached for 24h and a
# failed download is not retried for 5 minutes, so this is not fetched per job):
#
#   a) The stable gov.uk publication page. The newest CSV attachment is
#      discovered automatically (its media URL changes on every update):
#      UK_SPONSOR_REGISTER_URL=https://www.gov.uk/government/publications/register-of-licensed-sponsors-workers
#
#   b) A direct CSV export URL, e.g. copied from the publication page:
#      UK_SPONSOR_REGISTER_URL=https://assets.publishing.service.gov.uk/media/.../register-of-licensed-sponsors-workers-2026-01-01.csv
#
# Leave unset to disable verification entirely (no claims are made, no fetch).
# To find the current CSV by hand: open the publication page above, scroll to
# "Documents", and copy the "Register of licensed sponsors: workers" CSV link.
# UK_SPONSOR_REGISTER_URL=https://www.gov.uk/government/publications/register-of-licensed-sponsors-workers

# --- Optional search-pipeline audit log --------------------------------------
# Set to 1/true/yes/on to log one "Job search decision" line per listing (stage,
# source, employer, title, location, URL, match score) so you can see exactly why
# each listing was kept or dropped. Never logs descriptions or secrets. Leave
# unset for normal operation.
# JOB_SCOUT_DEBUG_DECISIONS=1

# --- Optional Phase 3 scheduling / alerts (all have sensible defaults) -------
# Durable state file directory (schedule, seen jobs, notification history).
# Defaults to ./data (or the OS temp dir on Vercel).
# JOB_SCOUT_STATE_DIR=./data

# Daily automatic search time in 24-hour HH:MM. Default 08:00.
# JOB_SCOUT_SCHEDULE_TIME=08:00

# IANA timezone for the schedule. Default Europe/London.
# JOB_SCOUT_TIMEZONE=Europe/London

# Start with automatic searches enabled (1/true/yes/on or 0/false/no/off).
# Default: enabled. Use /schedule off at any time without losing settings.
# JOB_SCOUT_SCHEDULE_ENABLED=1

# Maximum new-job alerts per scheduled run (1-20). Default 5; extra matches are
# summarised instead of flooding the chat.
# JOB_SCOUT_MAX_NOTIFICATIONS=5
