# Telegram bot credentials (replace the placeholders with your real values)
# Create the bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=000000000:REPLACE_WITH_YOUR_BOT_TOKEN

# Your numeric Telegram user ID (get it from @userinfobot). Only this user can use the bot.
TELEGRAM_ALLOWED_USER_ID=000000000

# --- Vercel / webhook settings (optional for local long polling) ---------------
# On Vercel you may provide the token as BOT_TOKEN instead of TELEGRAM_BOT_TOKEN.
# BOT_TOKEN=000000000:REPLACE_WITH_YOUR_BOT_TOKEN

# A random secret (1-256 chars of A-Z a-z 0-9 _ -) that Telegram echoes back in
# the X-Telegram-Bot-Api-Secret-Token header. Required for webhook mode.
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret

# Public base URL of the deployment, used by `npm run set-webhook`.
# On Vercel you can omit this: VERCEL_URL is provided automatically.
# TELEGRAM_WEBHOOK_URL=https://your-project.vercel.app
