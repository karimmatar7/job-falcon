{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "functions": {
    "api/scheduled-search.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/scheduled-search", "schedule": "0 7 * * *" },
    { "path": "/api/scheduled-search", "schedule": "0 8 * * *" }
  ]
}
